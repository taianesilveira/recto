# Required in every environment. Used to sign session cookies (HS256).
# Generate one with: openssl rand -base64 32
SESSION_SECRET=

# Optional locally. If unset, Recto uses PGlite (a Postgres build compiled
# to WASM) and stores data in ./.data/recto — no database to install.
# Set this to a Neon (or any Postgres) connection string in production.
DATABASE_URL=
